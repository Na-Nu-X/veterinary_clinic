# Copy to `.env` and adjust. All values are optional for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for SQLite. Production example:
# DATABASE_URL=postgres://vetclinic:password@localhost:5432/vetclinic
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
API_ANON_THROTTLE=120/min
API_SUBMISSION_THROTTLE=20/hour

# E-mail – console backend (prints to the runserver log) is the default.
# Production SMTP example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.sk
# EMAIL_PORT=587
# EMAIL_HOST_USER=recepcia@klinika-harmonia.sk
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Veterinárna klinika Harmónia <recepcia@klinika-harmonia.sk>

# Clinic details used in notification e-mails (keep in sync with site.config.ts)
CLINIC_NAME=Veterinárna klinika Harmónia
CLINIC_PHONE=+421 2 4820 1100
CLINIC_EMERGENCY_PHONE=+421 905 112 911
CLINIC_ADDRESS=Ružová dolina 14, 821 09 Bratislava
CLINIC_REPLY_TO_EMAIL=recepcia@klinika-harmonia.sk
# Comma-separated staff inboxes notified about every new booking
CLINIC_NOTIFICATION_EMAILS=recepcia@klinika-harmonia.sk
# Public URL of this backend – used for the admin link in staff e-mails
BACKEND_BASE_URL=http://localhost:8000
